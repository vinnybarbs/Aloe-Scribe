# Aloe Scribe Configuration
# Edit this file then restart Aloe Scribe

[calendar]
# Paste your iCal URL here.
# Google Calendar: Settings → your calendar → "Secret address in iCal format"
# Outlook/M365:   Settings → View all Outlook settings → Calendar → Shared calendars → Publish → copy ICS link
ical_url = ""

# How many minutes before a meeting to show the prompt
notify_minutes_before = 4

# How often to check the calendar (minutes)
poll_interval_minutes = 5

[audio]
# The mic is chosen in the app: the dropdown starts on "Select microphone…"
# and Start requires a choice. Auto-detect guessed wrong too often. Your
# selection persists here and is preselected whenever that device is
# actually connected.
# Linux:  Run `pactl list short sources` to list available sources
# macOS:  System audio is captured via ScreenCaptureKit, no extra
#         hardware/virtual-device setup required.
mic_source = ""
system_source = ""  # macOS: "system" (default), "off" for mic-only. Linux: .monitor source.

[transcriber]
# Which transcription backend to use:
#   "parakeet"  NVIDIA Parakeet TDT via parakeet-mlx (Apple Silicon).
#                Faster, less prone to silence-time hallucinations, better
#                accuracy on technical English. ~700 MB model downloaded
#                from HuggingFace on first run.
#   "whisper"   whisper.cpp via the binary in [whisper] below. Multilingual.
backend = "parakeet"

# HuggingFace model id used when backend = "parakeet"
parakeet_model = "mlx-community/parakeet-tdt-0.6b-v3"

# Speaker attribution. When true (default) and both mic + system audio are
# captured, the recording keeps them as separate channels and transcript
# lines are labeled by voice: M1, M2, ... for the local-mic side, which may
# be several people in a room, and R1, R2, ... for remote participants on system
# audio. Splitting voices on the same side uses on-device diarization
# (~36 MB of models auto-downloaded on first use). Without it, labels fall
# back to one per side. Set false for the old unlabeled mixed-mono behavior.
speaker_labels = true

# Speaker naming happens live in the Meeting Notes window: tag a name while
# that person is talking and the transcript labels become names
# automatically. The Done screen's "Name speakers…" button remains for
# after-the-fact fixes.

# Diarization clustering threshold. Lower splits voices more aggressively
# Over-splits are easy to fix, type the same name for both in the naming
# dialog. Higher merges more, and under-splits are not fixable afterward.
# Leave unset for the calibrated default (1.0).
#diarize_threshold = 1.0

[whisper]
# Path to your whisper.cpp binary
# Install: https://github.com/ggerganov/whisper.cpp
# macOS: build with Metal for GPU acceleration: cmake -B build -DWHISPER_METAL=ON
binary_path = "~/whisper.cpp/build/bin/whisper-cli"

# Model to use. Larger models are more accurate but slower.
# tiny, base, small, medium, large-v3
model = "small"

# Path to whisper model file
# Download with: bash /path/to/whisper.cpp/models/download-ggml-model.sh small
model_path = "~/whisper.cpp/models/ggml-large-v3-turbo.bin"

[output]
# Where transcripts land locally before syncing
local_dir = "~/meetings"

# Obsidian vault mode: attendee names in the document body become
# [[wikilinks]], so each person is a linked note with backlinks from every
# meeting they attended. Point local_dir inside your vault and enable.
obsidian_links = false

# Filename format (uses Python strftime + meeting title)
# {date} = 2026-04-06, {time} = 1000, {title} = meeting-title-slugified
filename_format = "{date}-{time}-{title}.md"

# Keep the recording WAV next to the transcript instead of deleting it after
# a successful transcription (~200 MB per hour of meeting). Useful when
# checking speaker labels or re-transcribing later.
keep_wav = false

[summarizer]
# Local executive summary written into the top of each transcript after it
# lands (Summary and Action items sections). Runs a small on-device model
# (Qwen 3.5 4B via MLX, ~2.9 GB fetched from this repo's GitHub Releases).
# Nothing leaves the machine. Set false to skip summaries.
enabled = true

# Model override: a local folder path. Leave empty for the bundled default.
model = ""

[sync]
# Set to true once rclone is configured
enabled = false

# Your rclone remote name + SharePoint path
# Example: "sharepoint:Documents/Meetings"
# Run `rclone config` to set up the remote
rclone_remote = "sharepoint:Documents/Meetings"

# Sync on file save (true) or on a schedule (false)
sync_on_save = true

[app]
# Hard cap on recording length: auto-stops and transcribes after this many
# minutes, even through system sleep. Safety net for forgotten recordings.
max_duration_minutes = 120

# Auto-stop after this many minutes of continuous silence (both the mic and
# system audio quiet). Catches a forgotten recording within minutes instead
# of waiting for the cap. Set 0 to disable. Raise it if your meetings have
# long stretches with nobody talking and no system audio.
silence_timeout_minutes = 10

# Show a desktop notification when sync completes
notify_on_sync = true
